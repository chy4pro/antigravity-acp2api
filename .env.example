# The gateway key is independent of Google credentials. If omitted, a local key
# is generated at .state/api-key (mode 0600).
# ACP2API_API_KEY=replace-with-a-long-random-key
ACP2API_HOST=127.0.0.1
ACP2API_PORT=8787
ACP2API_COMPATIBILITY=strict
ACP2API_AUTH_METHOD=oauth-personal
# Run npm run setup, or point to an existing official binary:
# ACP2API_COMMAND=/absolute/path/agy_acp_server.par
# ACP2API_ARGS=["--uid="]
ACP2API_MAX_SESSIONS=4
ACP2API_REQUEST_TIMEOUT_MS=120000
ACP2API_TOOL_TIMEOUT_MS=300000
ACP2API_SESSION_TTL_MS=900000
